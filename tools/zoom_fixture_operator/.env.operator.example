# Copy to .env.operator, chmod 600, and fill locally. Never commit real values.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SECRET_TOKEN=
EXITSPEC_PYTHON=.venv/bin/python

CAPTURE_ID=
CAPTURE_RAW_DIR=

PUBLIC_BASE_URL=
WEBHOOK_PATH=
OAUTH_CALLBACK_PATH=
PUBLIC_PORT=3000
OPERATOR_PORT=3001

CHAOS_FORCE_DISCONNECT_MEDIA_AFTER_FIRST_TRANSCRIPT_SEC=3
CAPTURE_WINDOW_SECONDS=900

# Keep false until the runbook prerequisites are all truthfully satisfied.
ALLOW_REAL_ZOOM_NETWORK=false
RTMS_CREDITS_CONFIRMED=false
SYNTHETIC_CAPTURE_AUTHORIZED=false
ZOOM_CREDENTIAL_ROTATION_ATTESTED=false
ZOOM_CREDENTIAL_ROTATION_RECEIPT_ID=
